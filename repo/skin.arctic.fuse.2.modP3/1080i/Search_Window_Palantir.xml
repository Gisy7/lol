<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="2000">
    <defaultcontrol always="true">9001</defaultcontrol>

    <!-- Animación de apertura del diálogo -->
    <include>Animation_DialogPopupOpenClose</include>

    <controls>
        <control type="group">
            <centerleft>50%</centerleft>
            <width>600</width>
            <centertop>50%</centertop>
            <height>400</height>

            <!-- Fondo del diálogo -->
            <include content="DialogBackgroundCommonsPalantir">
                <param name="width" value="600"/>
                <param name="height" value="400"/>
                <param name="header_label" value="Search"/>
            </include>

            <!-- Lista de opciones -->
            <control type="panel" id="9001">
                <include>ButtonMenuList</include>
                <content>
                    <item>
                        <label>Buscar Películas En Palantir</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ActivateWindow(Videos,$VAR[p3BusquedaPelisGeneral],return)</onclick>
                    </item>
                    <item>
                        <label>Buscar Series En Palantir</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ActivateWindow(Videos,$VAR[p3BusquedaSeriesGeneral],return)</onclick>
                    </item>
                    <item>
                        <label>Search local library</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ActivateWindow(Videos,library://search,return)</onclick>
                    </item>
                    <item>
                        <label>Search add-ons</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ActivateWindow(addonbrowser,addons://search/,return)</onclick>
                    </item>
                </content>
            </control>
        </control>
    </controls>
</window>
