<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.skin.modP3"
       name="Repositorio Mod Palantir 3"
       version="1.0.0"
       provider-name="Gisy7">

    <!-- Define que este addon es un repositorio -->
    <extension point="xbmc.addon.repository" name="Repositorio Mod Palantir 3">
        <dir>
            <!-- URL del addons.xml de tu repositorio -->
            <info compressed="false">
                https://raw.githubusercontent.com/Gisy7/lol/master/repo/zips/addons.xml
            </info>
            <checksum>
                https://raw.githubusercontent.com/Gisy7/lol/main/repo/zips/addons.xml.md5
            </checksum>
            <!-- Carpeta donde Kodi encontrará los ZIPs de los addons -->
            <datadir zip="true">
                https://raw.githubusercontent.com/Gisy7/lol/master/repo/zips/
            </datadir>
        </dir>
    </extension>

    <!-- Metadatos del repositorio -->
    <extension point="xbmc.addon.metadata">
        <summary>Repositorio de las skins Mod Palantir 3</summary>
        <description>Repositorio oficial de la skin Palantir 3 modificada</description>
        <platform>all</platform>
        <assets>
            <icon>icon.jpg</icon>
        </assets>
    </extension>

</addon>
